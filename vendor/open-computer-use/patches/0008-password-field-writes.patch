+class TreeAccessible(InterfaceOnlyAccessible):
+    def __init__(self, interfaces=("Accessible",), role="filler", states=(), children=()):
+        super().__init__(list(interfaces), role, states)
+        self.children = list(children)
+
+    def get_child_count(self):
+        return len(self.children)
+
+    def get_child_at_index(self, index):
+        return self.children[index]
+
+
+class PasswordFieldWriteTests(unittest.TestCase):
+    """Patch 0008: password fields never receive text, keys or values."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.runtime = load_runtime()
+
+    def field(self, role="text", focused=False):
+        states = ("editable", "focused") if focused else ("editable",)
+        return TreeAccessible(["Accessible", "Text", "EditableText"], role, states)
+
+    def test_set_value_refuses_a_password_field_before_any_write(self):
+        node = self.field("password text")
+        with mock.patch.object(self.runtime.Atspi.EditableText, "set_text_contents") as write:
+            with self.assertRaisesRegex(RuntimeError, "password_field"):
+                self.runtime.set_element_value(node, "hunter2")
+        write.assert_not_called()
+
+    def test_text_is_never_inserted_while_a_password_field_holds_focus(self):
+        secret = self.field("password text", focused=True)
+        window = TreeAccessible(children=[self.field(), secret])
+        with mock.patch.object(self.runtime.Atspi.EditableText, "insert_text") as write:
+            with self.assertRaisesRegex(RuntimeError, "password_field"):
+                self.runtime.insert_text(window, "hunter2")
+        write.assert_not_called()
+
+    def test_text_goes_to_the_focused_field_not_the_first_one(self):
+        first, second = self.field(), self.field(focused=True)
+        window = TreeAccessible(children=[first, second])
+        self.assertIs(self.runtime.text_target(window), second)
+
+    def test_an_unfocused_window_with_two_fields_is_refused(self):
+        window = TreeAccessible(children=[self.field(), self.field()])
+        with self.assertRaisesRegex(RuntimeError, "cannot tell which text field"):
+            self.runtime.text_target(window)
+
+    def test_a_focused_control_that_is_not_text_gets_keyboard_input(self):
+        button = TreeAccessible(role="push button", states=("focused",))
+        window = TreeAccessible(children=[self.field(), button])
+        self.assertIsNone(self.runtime.text_target(window))
+
+    def test_keys_are_refused_while_a_password_field_holds_focus(self):
+        window = TreeAccessible(children=[self.field("password text", focused=True)])
+        with self.assertRaisesRegex(RuntimeError, "password_field"):
+            self.runtime.refuse_password_focus(window)
+
