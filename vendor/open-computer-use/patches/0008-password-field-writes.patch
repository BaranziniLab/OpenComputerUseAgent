+PASSWORD_FIELD_REFUSAL = (
+    "password_field: that is a password field. Open Computer Use Agent never types into, sets "
+    "or clears password fields; ask the person to enter it themselves."
+)
+FOCUSED_PASSWORD_REFUSAL = (
+    "password_field: a password field in that app holds the keyboard, so nothing was sent. "
+    "Ask the person to enter it themselves, or click another field first."
+)
+
+
+def is_editable_text(node):
+    return supports_interface(node, "EditableText") and supports_interface(node, "Text")
+
+
+def find_focused(root):
+    return find_first(root, lambda node: state_contains(node, Atspi.StateType.FOCUSED))
+
+
+def refuse_password_focus(root):
+    """Keys and text go to the focused control: never to a password field."""
+    focused = find_focused(root)
+    if focused is not None and is_password(focused):
+        raise RuntimeError(FOCUSED_PASSWORD_REFUSAL)
+    return focused
+
+
+def text_target(root):
+    """The field typed text goes into: the focused one, never another.
+
+    Upstream inserted into the first editable field of the window whatever held focus, so
+    after a click that did not move focus the text landed in a different field.
+    """
+    focused = refuse_password_focus(root)
+    if focused is not None:
+        return focused if is_editable_text(focused) else None
+    candidates = []
+    for node in iter_all(root):
+        if is_editable_text(node) and not is_password(node):
+            candidates.append(node)
+            if len(candidates) > 1:
+                raise RuntimeError(
+                    "type_text cannot tell which text field has keyboard focus, so nothing was "
+                    "typed. Click the field first, or use set_value."
+                )
+    return candidates[0] if candidates else None
+
