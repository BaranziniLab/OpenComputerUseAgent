+
+    private var idleLongEnough: Bool {
+        activityLock.lock()
+        defer { activityLock.unlock() }
+        return activeConnections == 0 && Date().timeIntervalSince(lastActivity) >= appAgentIdleExitSeconds
+    }
+
+    private func idleLoop() {
+        while running {
+            Thread.sleep(forTimeInterval: 5)
+            guard running, idleLongEnough else { continue }
+            DispatchQueue.main.async {
+                // The permission window counts as activity: never close it under the person.
+                if NSApp.windows.contains(where: { $0.isVisible }) {
+                    self.noteConnection(opened: true)
+                    self.noteConnection(opened: false)
+                    return
+                }
+                NSApp.terminate(nil)
+            }
+            Thread.sleep(forTimeInterval: 5)
+        }
     }
 
