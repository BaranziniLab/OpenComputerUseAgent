+/// Patch 0009: the app agent exits after this long with no connection and no visible window.
+/// Upstream's agent never exited on its own, so a host that was killed or reinstalled left it
+/// running, holding the permissions and the files of an install that may no longer exist.
+/// Ten minutes, unless a test sets OPEN_COMPUTER_USE_APP_AGENT_IDLE_EXIT_SECONDS (5 to 3600);
+/// the extension's wrapper never passes it.
+private let appAgentIdleExitEnvironmentKey = "OPEN_COMPUTER_USE_APP_AGENT_IDLE_EXIT_SECONDS"
+private let appAgentIdleExitSeconds: TimeInterval = {
+    guard let raw = ProcessInfo.processInfo.environment[appAgentIdleExitEnvironmentKey],
+          let seconds = TimeInterval(raw), seconds.isFinite else {
+        return 600
+    }
+    return min(max(seconds, 5), 3600)
+}()
