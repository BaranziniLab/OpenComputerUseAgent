+// linuxPython is the distro interpreter that carries PyGObject and AT-SPI. Patch 0002 fixed it
+// to /usr/bin/python3 so a virtual environment first on PATH cannot shadow it; patch 0010 makes
+// it a variable only so the upstream tests can point it at their stub interpreter.
+var linuxPython = "/usr/bin/python3"
+
 func runPython(request linuxRequest) (*linuxResponse, error) {
 	if runtime.GOOS != "linux" {
 		return nil, errors.New("Linux Computer Use runtime requires python3 on Linux")
@@ -688,7 +693,7 @@ func runPython(request linuxRequest) (*linuxResponse, error) {
 	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
 	defer cancel()
 
-	cmd := exec.CommandContext(ctx, "/usr/bin/python3", scriptPath, operationPath)
+	cmd := exec.CommandContext(ctx, linuxPython, scriptPath, operationPath)
 	cmd.Env = linuxRuntimeEnvironment(os.Environ())
 	var stderr bytes.Buffer
 	cmd.Stderr = &stderr
