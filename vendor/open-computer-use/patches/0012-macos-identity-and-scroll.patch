@@ -0,0 +1,72 @@
+import ApplicationServices
+import XCTest
+@testable import OpenComputerUseKit
+
+/// Patch 0012: scrolling by the first accessibility way the app accepts, read from the position.
+final class ScrollWayTests: XCTestCase {
+    func testADeclinedWayThatMovedNothingIsPassedOver() throws {
+        var position = 0
+        var tried: [String] = []
+        let ways = [
+            ScrollWay(name: "AXScrollDownByPage", wholePagesOnly: true) { _ in tried.append("action"); return .attributeUnsupported },
+            ScrollWay(name: "page button", wholePagesOnly: true) { _ in tried.append("button"); position += 1; return .success },
+        ]
+        let used = try performScrollPage(ways: ways, preferred: nil, fraction: 1, read: { position },
+                                         elementIndex: "12", direction: "down")
+        XCTAssertEqual(used, 1)
+        XCTAssertEqual(tried, ["action", "button"])
+        XCTAssertEqual(position, 1)
+    }
+
+    func testAWayThatMovedThePositionCountsWhateverItAnswered() throws {
+        var position = 0
+        var buttonPresses = 0
+        let ways = [
+            ScrollWay(name: "AXScrollDownByPage", wholePagesOnly: true) { _ in position += 1; return .attributeUnsupported },
+            ScrollWay(name: "page button", wholePagesOnly: true) { _ in buttonPresses += 1; return .success },
+        ]
+        XCTAssertEqual(try performScrollPage(ways: ways, preferred: nil, fraction: 1, read: { position },
+                                             elementIndex: "5", direction: "down"), 0)
+        XCTAssertEqual(buttonPresses, 0, "a way that scrolled must never be followed by a second one")
+    }
+
+    func testAFailureThatMayStillActStopsTheChain() {
+        var later = 0
+        let ways = [
+            ScrollWay(name: "AXScrollDownByPage", wholePagesOnly: true) { _ in .cannotComplete },
+            ScrollWay(name: "page button", wholePagesOnly: true) { _ in later += 1; return .success },
+        ]
+        XCTAssertThrowsError(try performScrollPage(ways: ways, preferred: nil, fraction: 1, read: { 0 },
+                                                   elementIndex: "5", direction: "down"))
+        XCTAssertEqual(later, 0)
+    }
+
+    func testAFractionSkipsWholePageWaysAndTheChosenWayIsTriedFirst() throws {
+        var calls: [String] = []
+        let ways = [
+            ScrollWay(name: "page button", wholePagesOnly: true) { _ in calls.append("button"); return .success },
+            ScrollWay(name: "bar value", wholePagesOnly: false) { fraction in calls.append("bar \(fraction)"); return .success },
+        ]
+        XCTAssertEqual(try performScrollPage(ways: ways, preferred: 0, fraction: 0.5, read: { 0 },
+                                             elementIndex: "12", direction: "down"), 1)
+        XCTAssertEqual(try performScrollPage(ways: ways, preferred: 1, fraction: 1, read: { 0 },
+                                             elementIndex: "12", direction: "down"), 1)
+        XCTAssertEqual(calls, ["bar 0.5", "bar 1.0"])
+    }
+
+    func testNoAcceptedWayIsAClearRefusal() {
+        let ways = [ScrollWay(name: "AXScrollDownByPage", wholePagesOnly: true) { _ in .actionUnsupported }]
+        XCTAssertThrowsError(try performScrollPage(ways: ways, preferred: nil, fraction: 1, read: { 0 },
+                                                   elementIndex: "12", direction: "down")) { error in
+            XCTAssertTrue(String(describing: error).contains("nothing scrolled"))
+        }
+    }
+
+    func testAnIdentifierThatFailsToReadIsAnAbsence() {
+        // AppKit answers AXIdentifier on an NSTextView with kAXErrorFailure, every time.
+        XCTAssertTrue(ElementIdentity.readableAbsence(.failure, attribute: kAXIdentifierAttribute as String))
+        XCTAssertTrue(ElementIdentity.readableAbsence(.noValue, attribute: kAXTitleAttribute as String))
+        XCTAssertFalse(ElementIdentity.readableAbsence(.failure, attribute: kAXRoleAttribute as String))
+        XCTAssertFalse(ElementIdentity.readableAbsence(.cannotComplete, attribute: kAXIdentifierAttribute as String))
+    }
+}
