+    /// The accessibility ways an element offers, best first.
+    private func accessibilityScrollWays(record: ElementRecord, element: AXUIElement, probe: AccessibilityScrollProbe,
+                                         direction: String) -> [ScrollWay] {
+        var ways: [ScrollWay] = []
+        let actionName = "AXScroll\(direction.capitalized)ByPage"
+        if let rawAction = record.rawActions.first(where: { $0.caseInsensitiveCompare(actionName) == .orderedSame }) {
+            ways.append(ScrollWay(name: rawAction, wholePagesOnly: true) { _ in
+                AXUIElementPerformAction(element, rawAction as CFString)
+            })
+        }
+        guard let bar = probe.governingScrollBar else { return ways }
+        let forward = direction == "down" || direction == "right"
+        let pageSubrole = forward ? "AXIncrementPage" : "AXDecrementPage"
+        if let button = copyChildren(of: bar).first(where: { stringValue(of: $0, attribute: kAXSubroleAttribute) == pageSubrole }) {
+            ways.append(ScrollWay(name: "scroll bar page button", wholePagesOnly: true) { _ in
+                AXUIElementPerformAction(button, kAXPressAction as CFString)
+            })
+        }
+        if isSettable(element: bar, attribute: kAXValueAttribute), let page = scrollBarPageFraction(bar: bar, direction: direction) {
+            ways.append(ScrollWay(name: "scroll bar value", wholePagesOnly: false) { fraction in
+                var raw: CFTypeRef?
+                guard AXUIElementCopyAttributeValue(bar, kAXValueAttribute as CFString, &raw) == .success,
+                      let current = (raw as? NSNumber)?.doubleValue, current.isFinite, (0...1).contains(current) else {
+                    return .noValue
+                }
+                let target = min(max(current + (forward ? 1 : -1) * page * fraction, 0), 1)
+                return AXUIElementSetAttributeValue(bar, kAXValueAttribute as CFString, NSNumber(value: target))
+            })
+        }
+        return ways
+    }
+
+    /// How far one page moves a 0-to-1 scroll bar: the visible length over the length still hidden, read from the
+    /// scroll area that owns the bar. Nil when the area or its content cannot be measured.
+    private func scrollBarPageFraction(bar: AXUIElement, direction: String) -> Double? {
+        guard let area = copyParent(of: bar),
+              stringValue(of: area, attribute: kAXRoleAttribute) == kAXScrollAreaRole as String,
+              let visible = resolveLocalFrame(of: area, windowBounds: nil) else { return nil }
+        let vertical = direction == "up" || direction == "down"
+        let visibleLength = Double(vertical ? visible.height : visible.width)
+        var content = 0.0
+        for child in copyChildren(of: area) where stringValue(of: child, attribute: kAXRoleAttribute) != kAXScrollBarRole as String {
+            if let frame = resolveLocalFrame(of: child, windowBounds: nil) {
+                content = max(content, Double(vertical ? frame.height : frame.width))
+            }
+        }
+        guard visibleLength > 0, content > visibleLength else { return nil }
+        return visibleLength / (content - visibleLength)
+    }
+
