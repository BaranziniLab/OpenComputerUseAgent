+/// Patch 0012: one way to scroll an element by a page, or by a fraction of one. `perform` takes the fraction.
+struct ScrollWay {
+    let name: String
+    let wholePagesOnly: Bool
+    let perform: (Double) throws -> AXError
+}
+
+/// Whether a way's answer says it did nothing: the app does not offer it or has nothing to give.
+func scrollWayDeclined(_ result: AXError) -> Bool {
+    switch result {
+    case .actionUnsupported, .attributeUnsupported, .illegalArgument, .notImplemented, .noValue:
+        return true
+    default:
+        return false
+    }
+}
+
+/// Patch 0012: one page (or the last fraction of one) by the first way the app accepts, trying the way an earlier
+/// page used first. Whatever a way answers, the position decides: a way after which it moved scrolled (AppKit
+/// answers AXScrollDownByPage on a table's scroll area with attributeUnsupported and scrolls it), and a way that
+/// declined and left it as it was is passed over. Any other failure with no movement may still act, so nothing else
+/// is tried. Returns the way used.
+func performScrollPage<Observation: Equatable>(
+    ways: [ScrollWay],
+    preferred: Int?,
+    fraction: Double,
+    read: () throws -> Observation,
+    elementIndex: String,
+    direction: String
+) throws -> Int {
+    var order = Array(ways.indices)
+    if let preferred, let position = order.firstIndex(of: preferred) {
+        order.remove(at: position)
+        order.insert(preferred, at: 0)
+    }
+    var before: Observation?
+    for index in order {
+        let way = ways[index]
+        if way.wholePagesOnly && fraction < 1 { continue }
+        let previous: Observation
+        if let before { previous = before } else { previous = try read() }
+        before = previous
+        let result = try way.perform(fraction)
+        if result == .success { return index }
+        if try read() != previous { return index }
+        guard scrollWayDeclined(result) else {
+            throw ComputerUseError.message("scroll: \(way.name) answered AXError \(result.rawValue) and may still act, so no other way was tried. Read the app state before retrying.")
+        }
+    }
+    throw ComputerUseError.stateUnavailable("element \(elementIndex) offers no way to scroll \(direction) that the app accepted, so nothing scrolled. Try its enclosing scroll area.")
+}
