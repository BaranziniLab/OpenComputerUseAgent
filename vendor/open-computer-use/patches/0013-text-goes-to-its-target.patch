+function Get-KeyboardTargetLabel($operation) {
+    if ([string]$operation.target -eq "named") { return "element $($operation.element.index)" }
+    return "the field the last click aimed at"
+}
+
+function Test-TextEntryElement($element) {
+    return (Get-ElementControlTypeName $element) -match "Edit|Document"
+}
+
+function Test-PasswordEditWindow([IntPtr]$hwnd) {
+    return $hwnd -ne [IntPtr]::Zero -and (Test-EditWindowClass ([OCUWin32]::ClassName($hwnd))) -and
+        (([OCUWin32]::GetWindowLong($hwnd, $GWL_STYLE) -band $ES_PASSWORD) -ne 0)
+}
+
+# Patch 0013: the element a type_text or press_key must reach, or $null for the focused control. The
+# operation's target is "named" (element_index) or "clicked" (the element the last click aimed at).
+# Every refusal comes before anything is sent: text aimed at one field must never land in another.
+function Resolve-KeyboardTarget($element, $operation, [string]$tool) {
+    $source = [string]$operation.target
+    if ([string]::IsNullOrEmpty($source) -or $null -eq $operation.element) { return $null }
+    $label = Get-KeyboardTargetLabel $operation
+    if ($null -eq $element) {
+        # A named element that is gone was refused by Find-Element. A clicked text field that is gone,
+        # password or not, refuses; a clicked button that is gone leaves the focused control.
+        if ([string]$operation.element.controlType -match "Edit|Document") {
+            throw "${tool}: $label is gone, so nothing was sent. Click the field to use, or name it with element_index."
+        }
+        return $null
+    }
+    if ((Test-PasswordElement $element) -or (Test-PasswordEditWindow (Get-NativeWindowHandle $element))) {
+        if ($source -eq "named") { throw $script:PasswordFieldRefusal }
+        throw $script:AimedPasswordRefusal
+    }
+    if (-not (Test-TextEntryElement $element)) {
+        if ($source -eq "clicked") { return $null }
+        if ($tool -eq "type_text") { throw "type_text: $label is not a text field, so nothing was typed. Name a text field." }
+    }
+    return $element
+}
+
+function Test-ElementHoldsFocus($process, $element) {
+    $own = Get-NativeWindowHandle $element
+    if (-not $process.Hosted -and $own -ne [IntPtr]::Zero -and
+        (Get-PostedKeyTarget ([IntPtr]$process.MainWindowHandle)) -eq $own) { return $true }
+    try {
+        $focused = [Windows.Automation.AutomationElement]::FocusedElement
+        if ($null -ne $focused -and $focused.Current.ProcessId -eq $process.Id -and
+            (Same-RuntimeId @($focused.GetRuntimeId()) @($element.GetRuntimeId()))) { return $true }
+    } catch { }
+    return $false
+}
+
+# The edit control's own window, when the element has one: messages to it reach that control whatever
+# holds the keyboard.
+function Get-OwnEditWindow($process, $element) {
+    if ($process.Hosted) { return [IntPtr]::Zero }
+    $own = Get-NativeWindowHandle $element
+    if ($own -ne [IntPtr]::Zero -and (Test-EditWindowClass ([OCUWin32]::ClassName($own)))) { return $own }
+    return [IntPtr]::Zero
+}
+
+function Invoke-TypeTextInto($process, $element, [string]$text, [string]$label) {
+    $own = Get-OwnEditWindow $process $element
+    if ($own -ne [IntPtr]::Zero) {
+        if (([OCUWin32]::GetWindowLong($own, $GWL_STYLE) -band $ES_READONLY) -ne 0) {
+            throw "type_text: $label is read-only, so nothing was typed."
+        }
+        if ((Get-PostedKeyTarget ([IntPtr]$process.MainWindowHandle)) -ne $own) {
+            # Not holding the keyboard: its caret is wherever the last write left it, so the text goes at the
+            # end, where typing after a click would go.
+            $length = [OCUWin32]::SendMessage($own, $WM_GETTEXTLENGTH, [IntPtr]::Zero, [IntPtr]::Zero)
+            [void][OCUWin32]::SendMessage($own, $EM_SETSEL, $length, $length)
+        }
+        [void](Send-TextToEditHandle $own $text $element)
+        return
+    }
+    # No edit window of its own (WPF, UWP, a browser): keys are sent only once it holds the keyboard.
