@@ -0,0 +1,79 @@
+import ApplicationServices
+import XCTest
+@testable import OpenComputerUseKit
+
+/// Patch 0013: text and keys go to the element they are aimed at, or nowhere.
+final class KeyboardTargetTests: XCTestCase {
+    private func facts(_ label: String = "element 4", available: Bool = true, secure: Bool = false,
+                       textEntry: Bool = true) -> KeyboardAimFacts {
+        KeyboardAimFacts(label: label, available: available, secure: secure, textEntry: textEntry)
+    }
+
+    private func refusal(_ body: () throws -> KeyboardAimFacts?) -> String {
+        do {
+            _ = try body()
+            return ""
+        } catch {
+            return String(describing: error)
+        }
+    }
+
+    func testNothingNamedAndNoClickLeavesTheFocusedElement() throws {
+        XCTAssertNil(try keyboardAim(tool: "type_text", named: nil, aimed: nil))
+    }
+
+    func testANamedPasswordFieldIsRefusedForTextAndKeys() {
+        for tool in ["type_text", "press_key"] {
+            XCTAssertTrue(refusal { try keyboardAim(tool: tool, named: facts(secure: true), aimed: nil) }
+                .contains("password_field"), tool)
+        }
+    }
+
+    func testTheNamedElementWinsOverTheLastClick() throws {
+        let named = facts("element 1")
+        let chosen = try keyboardAim(tool: "type_text", named: named, aimed: facts("the field", secure: true))
+        XCTAssertEqual(chosen, named)
+    }
+
+    func testAClickOnAPasswordFieldRefusesTextSentWithoutATarget() {
+        // The drive's failure: the click left the keyboard in another field, and the text went there.
+        for tool in ["type_text", "press_key"] {
+            XCTAssertTrue(refusal { try keyboardAim(tool: tool, named: nil, aimed: facts("the field", secure: true)) }
+                .contains("password_field: the last click"), tool)
+        }
+    }
+
