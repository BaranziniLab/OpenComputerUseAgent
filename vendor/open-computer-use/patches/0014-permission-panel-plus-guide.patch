diff --git a/apps/OpenComputerUse/Tests/PermissionOnboardingTests/DraggableAppTileTests.swift b/apps/OpenComputerUse/Tests/PermissionOnboardingTests/DraggableAppTileTests.swift
new file mode 100644
index 0000000..1604e03
--- /dev/null
+++ b/apps/OpenComputerUse/Tests/PermissionOnboardingTests/DraggableAppTileTests.swift
@@ -0,0 +1,65 @@
+import AppKit
+import XCTest
+@testable import OpenComputerUse
+
+final class DraggableAppTileTests: XCTestCase {
+    func testClickWithSmallWobbleRevealsInsteadOfDragging() async throws {
+        try await MainActor.run {
+            let tile = DraggableAppTileView(frame: NSRect(x: 0, y: 0, width: 400, height: 43))
+            var reveals = 0
+            var drags = 0
+            tile.revealAction = { reveals += 1; return true }
+            tile.dragAction = { _, _ in drags += 1 }
+            tile.mouseDown(with: try tileMouseEvent(.leftMouseDown, at: NSPoint(x: 100, y: 20)))
+            tile.mouseDragged(with: try tileMouseEvent(.leftMouseDragged, at: NSPoint(x: 101, y: 22)))
+            tile.mouseUp(with: try tileMouseEvent(.leftMouseUp, at: NSPoint(x: 101, y: 22)))
+            XCTAssertEqual(reveals, 1)
+            XCTAssertEqual(drags, 0)
+        }
+    }
+
+    func testMoveBeyondTheThresholdDragsAndDoesNotReveal() async throws {
+        try await MainActor.run {
+            let tile = DraggableAppTileView(frame: NSRect(x: 0, y: 0, width: 400, height: 43))
+            var reveals = 0
+            var drags = 0
+            tile.revealAction = { reveals += 1; return true }
+            tile.dragAction = { _, _ in drags += 1 }
+            tile.mouseDown(with: try tileMouseEvent(.leftMouseDown, at: NSPoint(x: 100, y: 20)))
+            tile.mouseDragged(with: try tileMouseEvent(.leftMouseDragged, at: NSPoint(x: 110, y: 20)))
+            tile.mouseDragged(with: try tileMouseEvent(.leftMouseDragged, at: NSPoint(x: 140, y: 20)))
+            tile.mouseUp(with: try tileMouseEvent(.leftMouseUp, at: NSPoint(x: 140, y: 20)))
+            XCTAssertEqual(drags, 1)
+            XCTAssertEqual(reveals, 0)
+        }
+    }
+
+    func testMouseUpWithoutItsMouseDownRevealsNothing() async throws {
+        try await MainActor.run {
+            let tile = DraggableAppTileView(frame: NSRect(x: 0, y: 0, width: 400, height: 43))
+            var reveals = 0
+            tile.revealAction = { reveals += 1; return true }
+            tile.mouseUp(with: try tileMouseEvent(.leftMouseUp, at: NSPoint(x: 100, y: 20)))
+            tile.mouseDown(with: try tileMouseEvent(.leftMouseDown, at: NSPoint(x: 100, y: 20)))
+            tile.mouseUp(with: try tileMouseEvent(.leftMouseUp, at: NSPoint(x: 100, y: 20)))
+            tile.mouseUp(with: try tileMouseEvent(.leftMouseUp, at: NSPoint(x: 100, y: 20)))
+            XCTAssertEqual(reveals, 1)
+        }
+    }
+
+    func testPressFromAccessibilityReveals() async {
+        await MainActor.run {
+            let tile = DraggableAppTileView(frame: NSRect(x: 0, y: 0, width: 400, height: 43))
+            var reveals = 0
+            tile.revealAction = { reveals += 1; return true }
+            XCTAssertTrue(tile.accessibilityPerformPress())
+            XCTAssertEqual(tile.accessibilityRole(), .button)
+            XCTAssertEqual(reveals, 1)
+        }
+    }
+}
+
+private func tileMouseEvent(_ type: NSEvent.EventType, at point: NSPoint) throws -> NSEvent {
+    try XCTUnwrap(NSEvent.mouseEvent(with: type, location: point, modifierFlags: [], timestamp: 0,
+                                     windowNumber: 0, context: nil, eventNumber: 0, clickCount: 1, pressure: 1))
+}
